#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'pi: %s\n' "$1" >&2
  exit "${2:-64}"
}

agent_dir="${PI_CODING_AGENT_DIR:-${HOME}/.pi/agent}"
[[ "$agent_dir" == /* ]] || fail "PI_CODING_AGENT_DIR muss ein absoluter Pfad sein"
if [[ -n "${PI_RUNTIME_ROOT:-}" ]]; then
  runtime_bin="${PI_RUNTIME_ROOT}/dist/bundle/cli.js"
else
  runtime_bin="${agent_dir}/npm/node_modules/.bin/pi"
fi

[[ -x "$runtime_bin" ]] || fail "Pi-Runtime nicht ausführbar: $runtime_bin" 127
launcher_path="$(realpath -e -- "${BASH_SOURCE[0]}")"
runtime_path="$(realpath -e -- "$runtime_bin")"
[[ "$runtime_path" != "$launcher_path" ]] || fail "Pi-Runtime zeigt auf den Launcher selbst" 127

if [[ "${1:-}" != "system" ]]; then
  if [[ "${PI_LAUNCH_PROFILE:-}" == "system" ]]; then
    unset PI_CODING_AGENT_SESSION_DIR
  fi
  unset PI_LAUNCH_PROFILE PI_SYSTEM_WORKSPACE PI_SYSTEM_SESSION_DIR
  exec "$runtime_path" "$@"
fi
shift

profile_state_root="${agent_dir}/profile-state"
state_dir="${profile_state_root}/system"
workspace="${state_dir}/workspace"
sessions="${state_dir}/sessions"

# Never follow a link into a different profile or user-selected directory.
for directory in "$profile_state_root" "$state_dir" "$workspace" "$sessions"; do
  [[ ! -L "$directory" ]] || fail "Profilpfad darf kein Symlink sein: $directory" 73
done

umask 077
mkdir -p -- "$workspace" "$sessions"
for directory in "$profile_state_root" "$state_dir" "$workspace" "$sessions"; do
  [[ ! -L "$directory" ]] || fail "Profilpfad darf kein Symlink sein: $directory" 73
done
chmod 700 -- "$profile_state_root" "$state_dir" "$workspace" "$sessions"
workspace="$(realpath -e -- "$workspace")"
sessions="$(realpath -e -- "$sessions")"
cd -- "$workspace"

system_args=()
while (($#)); do
  case "$1" in
    --)
      system_args+=("$@")
      break
      ;;
    --approve|-a|--approve=*)
      # PIS keeps approval prompts off; ignore per-call attempts to turn them on.
      ;;
    *)
      system_args+=("$1")
      ;;
  esac
  shift
done

export PI_LAUNCH_PROFILE=system
export PI_SYSTEM_WORKSPACE="$workspace"
export PI_SYSTEM_SESSION_DIR="$sessions"
export PI_CODING_AGENT_SESSION_DIR="$sessions"
export PI_SUBAGENT_MAX_SPAWNS_PER_SESSION=2147483647

# Keep project resources out of the system profile. The launcher identity is
# descriptive; privileged capabilities must be authorized independently.
exec "$runtime_path" \
  --session-dir "$sessions" \
  --no-approve \
  --no-context-files \
  "${system_args[@]}"
