#!/usr/bin/env bash
# Shim für `pi gui`: leitet nur den Unterbefehl "gui" an die Minimal-GUI
# weiter; alles andere geht unverändert an das echte pi-Binary.
#
# Nutzung (PATH erweitern):
#   PATH="$PWD/bin:$PATH" pi gui
set -euo pipefail

script_path="$(realpath "${BASH_SOURCE[0]}")"
here="$(cd "$(dirname "$script_path")" && pwd)"

if [[ "${1:-}" == "gui" ]]; then
  shift
  exec "$here/pi-gui" "$@"
fi

real="${PI_GUI_REAL_PI:-}"
if [[ -z "$real" ]]; then
  IFS=":" read -ra dirs <<<"${PATH}"
  for dir in "${dirs[@]}"; do
    [[ -z "$dir" ]] && continue
    candidate="$dir/pi"
    if [[ -x "$candidate" ]]; then
      resolved_candidate="$(realpath "$candidate" 2>/dev/null || true)"
      if [[ "$resolved_candidate" == "$script_path" ]]; then
        continue
      fi
      real="$candidate"
      break
    fi
  done
fi

if [[ -z "$real" ]]; then
  echo "pi: echtes pi-Binary nicht gefunden (PI_GUI_REAL_PI setzen)" >&2
  exit 127
fi
exec "$real" "$@"
