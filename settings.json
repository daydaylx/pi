{
  "lastChangelogVersion": "0.84.3",
  "theme": "aurora-night",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768,
    "xhigh": 100000
  },
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "qwen-token-plan-individual/qwen3.8-max",
    "qwen-token-plan-individual/qwen3.7-max",
    "qwen-token-plan-individual/qwen3.7-plus",
    "qwen-token-plan-individual/qwen3.6-flash",
    "qwen-token-plan-individual/glm-5.2",
    "qwen-token-plan-individual/deepseek-v4-pro",
    "qwen-token-plan-individual/deepseek-v4-pro-0813",
    "qwen-token-plan-individual/deepseek-v4-flash-0731",
    "openai-codex/gpt-5.4-mini",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.5",
    "zai/glm-5.2",
    "zai/glm-4.7",
    "openrouter/tencent/hy3",
    "openrouter/openai/gpt-oss-20b:free",
    "opencode-go/qwen3.7-plus",
    "opencode-go/qwen3.7-max",
    "opencode-go/qwen3.6-plus",
    "opencode-go/minimax-m3",
    "opencode-go/minimax-m2.7",
    "opencode-go/mimo-v2.5-pro",
    "opencode-go/mimo-v2.5",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/kimi-k2.6",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "anthropic/claude-sonnet-5",
    "opencode-go/deepseek-v4-pro",
    "openrouter/openai/gpt-oss-120b",
    "zai/glm-5.3",
    "zai-coding-cn/glm-5.3",
    "openrouter/stealth/ox-alpha",
    "openrouter/dots-studio/dots-3-note-preview:free",
    "openrouter/z-ai/glm-5.2:free"
  ],
  "packages": [
    "git:github.com/daydaylx/pi-subagents@11f3fcbc0e346f747df2bd8342d77cb8c9f8c962",
    "npm:pi-web-access@0.24.2"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "investigator": {
        "model": "openai-codex/gpt-5.6-terra",
        "fallbackModels": [
          "qwen-token-plan-individual/qwen3.8-max"
        ]
      },
      "debugger": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "max",
        "fallbackModels": [
          "qwen-token-plan-individual/qwen3.8-max"
        ]
      },
      "verifier": {
        "model": "anthropic/claude-sonnet-5",
        "thinking": "max",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra"
        ]
      }
    },
    "modelScope": {
      "enforce": true,
      "allow": [
        "qwen-token-plan-individual/*",
        "anthropic/claude-sonnet-5",
        "openai-codex/gpt-5.6-terra"
      ]
    }
  },
  "extensions": [
    "!extensions/**",
    "+extensions/setup-core/index.ts",
    "+extensions/plan-mode/index.ts",
    "+extensions/mode-permissions.ts",
    "+extensions/lsp/index.ts",
    "+extensions/ask-user.ts",
    "+extensions/diff-viewer/index.ts",
    "+extensions/control-plane.ts",
    "+extensions/compact-tools/index.ts",
    "+extensions/aurora-ui/index.ts",
    "+extensions/resilience/index.ts",
    "+extensions/session-health/index.ts",
    "+extensions/openrouter-doctor/index.ts"
  ],
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "editorPaddingX": 1,
  "autocompleteMaxVisible": 8,
  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": false,
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "showHardwareCursor": true
}
