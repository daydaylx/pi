{
  "tuiMode": "fullscreen",
  "lastChangelogVersion": "0.84.4",
  "theme": "aurora-forge",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-luna",
  "hideThinkingBlock": true,
  "defaultThinkingLevel": "high",
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768,
    "xhigh": 100000
  },
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-6-luna",
    "anthropic/claude-sonnet-5",
    "openrouter/thinkingmachines/inkling:free",
    "openrouter/nvidia/nemotron-3.5-lightning:free",
    "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
    "openrouter/nvidia/nemotron-3-ultra-550b-a55b",
    "openrouter/thinkingmachines/inkling-small:free",
    "openrouter/dots-studio/dots-3-note-preview:free",
    "openrouter/inclusionai/ling-3.0-flash-sante:free",
    "openrouter/liquid/lfm-2.5-2.6b:free"
  ],
  "packages": [
    "git:github.com/daydaylx/pi-subagents@0364aaa5851507f2e2d1e4e566e2b14c88b2f9b6",
    "npm:pi-web-access@0.24.2"
  ],
  "subagents": {
    "disableBuiltins": true,
    "agentOverrides": {
      "verifier": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna",
          "openai-codex/gpt-5.6-terra"
        ]
      }
    },
    "modelScope": {
      "enforce": true,
      "allow": [
        "anthropic/claude-sonnet-5",
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.6-terra",
        "openai-codex/gpt-6-luna"
      ]
    }
  },
  "extensions": [
    "!extensions/**",
    "+extensions/setup-core/index.ts",
    "+extensions/plan-mode/index.ts",
    "+extensions/mode-permissions.ts",
    "+extensions/interactive-pty/index.ts",
    "+extensions/lsp/index.ts",
    "+extensions/ask-user.ts",
    "+extensions/control-plane.ts",
    "+extensions/compact-tools/index.ts",
    "+extensions/aurora-ui/index.ts",
    "+extensions/resilience/index.ts",
    "+extensions/context-capsule/index.ts",
    "+extensions/system-context/index.ts",
    "+extensions/session-health/index.ts",
    "+extensions/frontend-bridge/index.ts",
    "+extensions/openrouter-doctor/index.ts",
    "+extensions/task-tier/index.ts"
  ],
  "doubleEscapeAction": "tree",
  "treeFilterMode": "all",
  "editorPaddingX": 1,
  "autocompleteMaxVisible": 8,
  "compaction": {
    "enabled": true,
    "reserveTokens": 49152,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": true
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 4000,
    "provider": {
      "timeoutMs": 3600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "terminal": {
    "showImages": false,
    "showTerminalProgress": true
  },
  "images": {
    "blockImages": true
  },
  "showHardwareCursor": true
}
