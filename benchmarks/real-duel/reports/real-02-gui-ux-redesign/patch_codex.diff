+  waiting: { label: "Eingabe erforderlich", detail: "Pi wartet auf deine Entscheidung", dot: "warn" },
+};
+
+function setLiveActivity(kind, detail = "") {
+  state.liveActivity = {
+    kind: ACTIVITY_PRESENTATION[kind] ? kind : "starting",
+    detail: String(detail || "").slice(0, 180),
+    startedAt: Date.now(),
+  };
+  refreshStatusBar();
+}
+
+function activityElapsedLabel() {
+  const startedAt = state.liveActivity.startedAt;
+  if (!startedAt || !state.busy) return "";
+  return runsModule.formatDuration(Date.now() - startedAt);
+}
+
+function refreshActivityStatus() {
+  const section = el("activity-status");
+  if (!section) return;
+
+  section.hidden = !state.connected;
+  if (!state.connected) return;
+
+  const waiting = state.pendingUserRequests > 0;
+  const activeTools = [...state.activeTools.values()];
+  const kind = waiting ? "waiting" : state.liveActivity.kind;
+  const presentation = ACTIVITY_PRESENTATION[kind] || ACTIVITY_PRESENTATION.idle;
+  const label = el("activity-status-label");
+  const detail = el("activity-status-detail");
+  const meta = el("activity-status-meta");
+  const dot = el("activity-status-dot");
+  const changesButton = el("btn-activity-changes");
+  const planDecision = el("btn-plan-decision");
+  const planReady = state.core?.workflow?.planReady;
+  const changes = state.core?.changes;
+  const changedFiles = changes?.filesCount ?? state.editedFiles.size;
+
+  if (label) label.textContent = presentation.label;
+  if (detail) {
+    detail.textContent = waiting
+      ? presentation.detail
+      : state.liveActivity.detail || presentation.detail;
+  }
+  if (meta) {
+    if (waiting) meta.textContent = "Aktion nötig";
+    else if (activeTools.length > 1)
+      meta.textContent = `${activeTools.length} Werkzeuge laufen`;
+    else if (activeTools.length === 1)
+      meta.textContent = activeTools[0].target || "Werkzeug läuft";
+    else meta.textContent = activityElapsedLabel();
+  }
+  if (dot) dot.className = `dot ${presentation.dot}`;
+  if (changesButton) {
+    changesButton.hidden = changedFiles === 0;
+    if (changedFiles > 0) {
+      changesButton.textContent = changes
+        ? `${changedFiles} geändert · +${changes.linesAdded}/−${changes.linesRemoved}`
+        : `${changedFiles} geändert`;
+      changesButton.title = "Geänderte Dateien und Diffs anzeigen";
+    }
+  }
+  if (planDecision) {
+    planDecision.hidden = !planReady || state.busy;
+    planDecision.title = planReady
+      ? "Entscheidung zum fertigen Plan öffnen"
+      : "";
+  }
+}
