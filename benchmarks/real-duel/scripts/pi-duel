#!/usr/bin/env python3
"""Duenner Wrapper um OpenBench fuer den real-duel-Workflow (Modus A).

Nutzt OpenBenchs eigene Bausteine direkt statt sie neu zu bauen:
  - obench.candidates.ManifestHarness.run()   fuer die reale CLI-Invokation
    (Env-Policy, isolate_home=false-Handling, Auth-Kopie-Logik -- unveraendert
    von OpenBench uebernommen).
  - obench.run.run_checker()                  fuer die Checker-Ausfuehrung
    (TASK_DIR-Env, SCORE:-Parsing -- unveraendert uebernommen).
  - `obench doctor` / `obench gate` / `obench report` als externe CLI-Aufrufe.

Ersetzt wird NUR die Workspace-Materialisierung: obench.run erzeugt Workspaces
immer in einem frischen, .git-losen Tempdir (git-archive-Export, siehe
obench/workspace.py) -- das ist mit der real-duel-Anforderung nach echten
Git-Worktrees (volle Historie, .git, git status/diff/log/blame) unvereinbar.
Dieses Skript erzeugt daher die Worktrees selbst und uebergibt sie direkt als
workdir an die uebernommenen OpenBench-Funktionen. Details: siehe
REAL_DUEL_AUDIT.md.

Subcommands: doctor | gate | smoke | run --task <dir> | report | cleanup <run-id>
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

REPO = Path("/home/d/.pi/agent")
REAL_DUEL_DIR = REPO / "benchmarks" / "real-duel"
OPENBENCH_HOME = Path(os.path.expanduser("~/.local/share/real-duel/openbench"))
STATE = Path(os.path.expanduser("~/.local/state/real-duel"))
WORKTREES_ROOT = STATE / "worktrees"
WORKSPACE_DIR = STATE / "obench-workspace"
RESULTS_PATH = WORKSPACE_DIR / "results.jsonl"
TRANSCRIPTS_DIR = WORKSPACE_DIR / "transcripts"
FINGERPRINTS_DIR = WORKSPACE_DIR / "fingerprints"

CANDIDATES = {
    "pi-real": REAL_DUEL_DIR / "candidates" / "pi-real.toml",
    "codex-real": REAL_DUEL_DIR / "candidates" / "codex-real.toml",
}
MODEL = "gpt-5.6-terra"


def _obench_bin():
    b = OPENBENCH_HOME / ".venv" / "bin" / "obench"
    if not b.exists():
        sys.exit(f"OpenBench nicht gefunden unter {b} -- siehe OPENBENCH_LOCK fuer Setup.")
    return b


def _run_obench_cli(args):
    return subprocess.run([str(_obench_bin())] + args, cwd=OPENBENCH_HOME).returncode


def cmd_doctor(_args):
    return _run_obench_cli(["doctor"])


def cmd_gate(_args):
    rc = 0
    for name, path in CANDIDATES.items():
        print(f"=== obench gate: {name} (isolate_home=false -> Ablehnung erwartet) ===")
        r = _run_obench_cli(["gate", str(path), "--model", MODEL])
        rc = rc or r
    return rc


def _load_fingerprint_module():
    sys.path.insert(0, str(REAL_DUEL_DIR / "scripts"))
    import fingerprint as fingerprint_module  # noqa: E402
    return fingerprint_module


def _load_telemetry_module():
    sys.path.insert(0, str(REAL_DUEL_DIR / "scripts"))
    import telemetry as telemetry_module  # noqa: E402
    return telemetry_module


def _make_worktree(run_id, arm, base_sha):
    wt = WORKTREES_ROOT / run_id / arm
    wt.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        ["git", "-C", str(REPO), "worktree", "add", str(wt), base_sha],
        check=True,
    )
    return wt


def _load_obench_modules():
    sys.path.insert(0, str(OPENBENCH_HOME))
    from obench.candidates import load_candidate  # noqa: E402
    from obench.run import make_run_id, read_instruction, run_checker  # noqa: E402
    return load_candidate, make_run_id, read_instruction, run_checker


def _run_task(task_dir, task_name, run_prefix, args):
    """Gemeinsame Kernlogik fuer `smoke` (checker.sh vorhanden) und `run`
    (offene reale Aufgabe, meist ohne checker.sh -- funktionale Bewertung
    erfolgt separat ueber die Projekt-Verify-Kommandos, siehe REAL_DUEL_AUDIT.md
    Phase-3-Abschnitt)."""
    run_id_base = run_prefix + "-" + time.strftime("%Y%m%dT%H%M%S")
    has_checker = (task_dir / "checker.sh").exists()

    load_candidate, make_run_id, read_instruction, run_checker = _load_obench_modules()
    instruction = read_instruction(str(task_dir))

    # Candidates werden VOR dem Dirty-Gate geladen (reine Parsing-Operation,
    # keine Subprozess-Ausfuehrung) -- ihr Provenance-Hash und die aufgeloeste
    # Modell-ID fliessen in den Fingerprint ein.
    candidates = {name: load_candidate(str(path), None) for name, path in CANDIDATES.items()}

    fingerprint_module = _load_fingerprint_module()
    fp = fingerprint_module.compute_fingerprint(
        candidates=candidates, task_instruction=instruction,
        dirty_override=args.allow_dirty, model=MODEL,
    )
    FINGERPRINTS_DIR.mkdir(parents=True, exist_ok=True)
    (FINGERPRINTS_DIR / f"{run_id_base}.json").write_text(json.dumps(fp, indent=2))
    print(json.dumps(fp, indent=2))

    if not fp["canonical_repo_clean"] and not args.allow_dirty:
        print(
            "\nERROR:\nrepository is dirty\n"
            "real-duel requires a clean canonical configuration baseline\n\n"
            f"{len(fp['dirty_files_list'])} dirty/untracked path(s) in {REPO}:",
            file=sys.stderr,
        )
        for line in fp["dirty_files_list"]:
            print(f"  {line}", file=sys.stderr)
        print(
            "\nPi laedt seine Agent-Konfiguration (settings.json, AGENTS.md, "
            "APPEND_SYSTEM.md) real aus diesem Verzeichnis, unabhaengig vom "
            "Task-Worktree -- ein unsauberer Stand macht den Vergleich nicht "
            "reproduzierbar. Commit/stash die Aenderungen, oder erzwinge "
            "bewusst mit --allow-dirty (Lauf wird dann als "
            "comparable=false markiert).",
            file=sys.stderr,
        )
        return 1

    if not fp["canonical_repo_clean"] and args.allow_dirty:
        print(
            f"\nWARN: --allow-dirty -- {len(fp['dirty_files_list'])} dirty/"
            "untracked path(s), Lauf wird als comparable=false markiert",
            file=sys.stderr,
        )

    base_sha = fp["base_sha"]

    WORKSPACE_DIR.mkdir(parents=True, exist_ok=True)
    TRANSCRIPTS_DIR.mkdir(parents=True, exist_ok=True)

    arm_by_candidate = {"pi-real": "pi", "codex-real": "codex"}

    def _execute_arm(cand_name, candidate):
        arm = arm_by_candidate[cand_name]
        print(f"=== {cand_name}: worktree ===")
        workdir = _make_worktree(run_id_base, arm, base_sha)
        print(f"worktree ({cand_name}): {workdir}")

        run_id = make_run_id(cand_name, task_name, MODEL, 1, candidate.identity_digest)

        print(f"=== {cand_name}: invoke ({run_id}) ===")
        t0 = time.monotonic()
        result = candidate.run(instruction, str(workdir), MODEL, args.timeout)
        wall_time = round(time.monotonic() - t0, 3)

        if has_checker:
            checker_exit, raw_score, checker_stdout, checker_stderr = run_checker(
                str(task_dir), str(workdir), args.checker_timeout)
            success = checker_exit == 0
        else:
            # Offene reale Aufgabe ohne Skript-Orakel: kein automatisches
            # pass/fail hier. Funktionale Bewertung (Tests/Typecheck/Lint/
            # Build/Verify, Baselinefehler getrennt behandelt) erfolgt als
            # eigener Schritt je Worktree nach Abschluss beider Arme.
            checker_exit, raw_score, checker_stdout, checker_stderr = None, None, None, None
            success = None

        transcript_path = TRANSCRIPTS_DIR / f"{run_id_base}_{arm}.txt"
        full_output = result.get("full_output") or ""
        transcript_path.write_text(full_output)

        telemetry_module = _load_telemetry_module()
        telemetry = telemetry_module.normalize(cand_name, full_output)

        row = {
            "run_id": run_id,
            "ts_iso": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime()),
            "harness": cand_name,
            "model": MODEL,
            "task": task_name,
            "trial": 1,
            "success": success,
            "completed": bool(result.get("completed")),
            "error": result.get("error"),
            "wall_time_s": wall_time,
            "cmd": result.get("cmd"),
            "checker_exit": checker_exit,
            "checker_stdout": checker_stdout,
            "checker_stderr": checker_stderr,
            "score": (raw_score if raw_score is not None
                      else (None if success is None else (1.0 if success else 0.0))),
            "exec_mode": "local",
            "candidate_provenance": candidate.provenance,
            "base_sha": base_sha,
            "workdir": str(workdir),
            "comparable": fp["comparable"],
            "dirty_override": fp["dirty_override"],
            # Flache Legacy-Skalare, damit `obench report`s eigene tok/slv-
            # Aggregation (obench/stats.py:effective_tokens liest row["tokens"]
            # top-level) unveraendert weiterfunktioniert.
            "tokens": (telemetry["input_fresh"] + telemetry["output"]
                       if None not in (telemetry["input_fresh"], telemetry["output"])
                       else None),
            "turns": telemetry["model_calls"],
            "token_basis": telemetry["token_basis"],
            # Normalisierte Telemetrie (Phase 2), siehe scripts/telemetry.py --
            # eine primaere Quelle pro Harness (OpenBenchs eigene, gegen die
            # real installierten CLI-Versionen validierte Parser).
            "telemetry": telemetry,
        }
        print(f"=== {cand_name}: checker_exit={checker_exit} success={success} "
              f"wall_time_s={wall_time} model_calls={telemetry['model_calls']} "
              f"input_fresh={telemetry['input_fresh']} "
              f"cache_read={telemetry['input_cache_read']} "
              f"output={telemetry['output']} ===")
        return row, {
            "success": success, "checker_exit": checker_exit,
            "wall_time_s": wall_time, "workdir": str(workdir),
            "model_calls": telemetry["model_calls"],
            "input_fresh": telemetry["input_fresh"],
            "input_cache_read": telemetry["input_cache_read"],
            "output": telemetry["output"],
            "tool_calls": telemetry["tool_calls"],
            "tool_errors": telemetry["tool_errors"],
        }

    # Beide Arme laufen parallel (unabhaengige Worktrees, unabhaengige
    # Prozesse -- Pi schreibt nur nach ~/.pi/agent, Codex nur nach
    # ~/.codex, keine gemeinsame veraenderliche Ressource) -- spart bei
    # laengeren realen Aufgaben deutlich Wall-Time gegenueber sequentieller
    # Ausfuehrung.
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(max_workers=len(candidates)) as pool:
        futures = {pool.submit(_execute_arm, name, cand): name
                   for name, cand in candidates.items()}
        results_by_name = {}
        for fut in futures:
            name = futures[fut]
            results_by_name[name] = fut.result()

    RESULTS_PATH.parent.mkdir(parents=True, exist_ok=True)
    summary = {}
    with open(RESULTS_PATH, "a", encoding="utf-8") as fh:
        for cand_name in candidates:
            row, summary_entry = results_by_name[cand_name]
            fh.write(json.dumps(row) + "\n")
            summary[cand_name] = summary_entry

    print("\n=== Zusammenfassung ===")
    print(json.dumps(summary, indent=2))
    print(f"\nrun_id: {run_id_base}")
    print(f"Aufraeumen mit: pi-duel cleanup {run_id_base}")
    successes = [s["success"] for s in summary.values()]
    if any(s is None for s in successes):
        return 0  # offene Aufgabe: kein Skript-Orakel, funktionale Bewertung folgt separat
    return 0 if all(successes) else 1


def cmd_smoke(args):
    task_dir = REAL_DUEL_DIR / "tasks" / "smoke-01-marker-file"
    return _run_task(task_dir, "smoke-01-marker-file", "smoke-01", args)


def cmd_run(args):
    task_dir = Path(args.task).resolve()
    if not task_dir.is_dir():
        sys.exit(f"Task-Verzeichnis nicht gefunden: {task_dir}")
    if not (task_dir / "instruction.md").exists():
        sys.exit(f"{task_dir} enthaelt keine instruction.md")
    return _run_task(task_dir, task_dir.name, task_dir.name, args)


def cmd_report(_args):
    if not RESULTS_PATH.exists():
        sys.exit(f"keine results.jsonl unter {RESULTS_PATH} -- erst 'pi-duel smoke' laufen lassen")
    return _run_obench_cli(["report", "--results-path", str(RESULTS_PATH)])


def cmd_cleanup(args):
    root = WORKTREES_ROOT / args.run_id
    for arm in ("pi", "codex"):
        wt = root / arm
        if wt.exists():
            subprocess.run(
                ["git", "-C", str(REPO), "worktree", "remove", str(wt), "--force"],
                check=False,
            )
    print(f"aufgeraeumt: {root}")
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor", help="obench doctor")
    sub.add_parser("gate", help="obench gate fuer beide Candidates (Ablehnung erwartet)")

    p_smoke = sub.add_parser("smoke", help="Fingerprint + Worktrees + Smoke-Task fuer beide Candidates")
    p_smoke.add_argument("--timeout", type=int, default=600, help="Adapter-Timeout in Sekunden (default: 600)")
    p_smoke.add_argument("--checker-timeout", type=int, default=120, help="Checker-Timeout in Sekunden (default: 120)")
    p_smoke.add_argument("--allow-dirty", action="store_true",
                          help="Lauf trotz unsauberem canonical repo erzwingen "
                               "(Ergebnis wird comparable=false markiert)")

    p_run = sub.add_parser("run", help="Beliebige reale Aufgabe fuer beide Candidates (Phase 3)")
    p_run.add_argument("--task", required=True, help="Pfad zum Task-Verzeichnis (instruction.md, optional checker.sh)")
    p_run.add_argument("--timeout", type=int, default=5400, help="Adapter-Timeout in Sekunden (default: 5400 = 90min)")
    p_run.add_argument("--checker-timeout", type=int, default=300, help="Checker-Timeout in Sekunden (default: 300)")
    p_run.add_argument("--allow-dirty", action="store_true",
                        help="Lauf trotz unsauberem canonical repo erzwingen "
                             "(Ergebnis wird comparable=false markiert)")

    sub.add_parser("report", help="obench report ueber die real-duel results.jsonl")

    p_cleanup = sub.add_parser("cleanup", help="Worktrees eines Laufs entfernen")
    p_cleanup.add_argument("run_id")

    args = parser.parse_args()
    dispatch = {
        "doctor": cmd_doctor, "gate": cmd_gate, "smoke": cmd_smoke, "run": cmd_run,
        "report": cmd_report, "cleanup": cmd_cleanup,
    }
    sys.exit(dispatch[args.command](args))


if __name__ == "__main__":
    main()
