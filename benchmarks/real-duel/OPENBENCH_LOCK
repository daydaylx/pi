# Installation (bewusst AUSSERHALB dieses Repos, siehe README.md):
#
#   mkdir -p ~/.local/share/real-duel
#   git clone "$REPO_URL" ~/.local/share/real-duel/openbench
#   cd ~/.local/share/real-duel/openbench
#   git checkout "$PINNED_SHA"
#   uv venv -q && uv pip install -q -e .
#   ./.venv/bin/obench --version
#
# Ein Upgrade auf einen neueren Commit ist eine bewusste, explizite Aktion:
# neuen SHA/Tag hier eintragen, Checkout aktualisieren, Kandidaten-Manifeste
# und dieses Dokument gegen den neuen Code-Stand erneut pruefen (insbesondere
# obench/candidates.py und obench/workspace.py, da real-duel deren internes
# Verhalten direkt importiert, siehe scripts/pi-duel).
