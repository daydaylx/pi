{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Benchmark V2 Manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "reference", "seriesId", "privateEvaluator", "roles", "runs"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "name": { "const": "pi-benchmark-v2" },
    "reference": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seriesId": { "const": "P4" },
    "privateEvaluator": { "const": "PI_BENCHMARK_PRIVATE_ROOT" },
    "roles": { "type": "object" },
    "runs": { "type": "array", "minItems": 1 }
  }
}
