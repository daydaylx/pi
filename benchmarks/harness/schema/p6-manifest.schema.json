{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Benchmark P6-TERRA-SUBAGENTS Manifest",
  "description": "Same-model comparison at gpt-5.6-terra with subagent delegation allowed on both sides (Pi's real production stack: main/investigator=terra@high, debugger=terra@max, verifier=claude-sonnet-5@max; Codex: terra with its native multi-agent feature unrestricted). Distinct from P5-LUNA-HARNESS (Core Parity, no subagents, model=luna) — never mixed with it.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "reference",
    "seriesId",
    "mode",
    "privateEvaluator",
    "promptSuffix",
    "harnesses",
    "runs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "const": "pi-benchmark-p6-terra-subagents" },
    "reference": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seriesId": { "const": "P6-TERRA-SUBAGENTS" },
    "mode": { "const": "subagents-allowed" },
    "privateEvaluator": { "const": "PI_BENCHMARK_PRIVATE_ROOT" },
    "promptSuffix": {
      "type": "string",
      "description": "Appended verbatim, identically, to the same public prompt text on both harnesses — instructs the agent to make its best reasonable assumption instead of asking a clarifying question that can never be answered in single-shot mode."
    },
    "harnesses": {
      "type": "object",
      "required": ["pi", "codex"],
      "properties": {
        "pi": {
          "type": "object",
          "required": [
            "provider",
            "model",
            "thinking",
            "roles",
            "settingsOverlay"
          ],
          "properties": {
            "provider": { "const": "openai-codex" },
            "model": { "const": "gpt-5.6-terra" },
            "thinking": { "type": "string" },
            "settingsOverlay": {
              "const": false,
              "description": "No settings.json overlay is applied for this series — the worktree's own default (== the user's real production settings.json) already pins main/investigator/debugger to gpt-5.6-terra and verifier to claude-sonnet-5."
            },
            "roles": { "type": "object" }
          }
        },
        "codex": {
          "type": "object",
          "required": [
            "cliVersion",
            "model",
            "reasoningEffort",
            "sandbox",
            "networkAccess"
          ],
          "properties": {
            "cliVersion": { "type": "string" },
            "model": { "const": "gpt-5.6-terra" },
            "reasoningEffort": { "type": "string" },
            "sandbox": { "const": "workspace-write" },
            "networkAccess": { "const": false }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "task", "harness", "stackMode"],
        "properties": {
          "id": { "type": "string", "pattern": "^p6-[a-z0-9-]+$" },
          "task": { "type": "string" },
          "harness": { "enum": ["pi", "codex"] },
          "stackMode": { "const": "subagents-allowed" }
        }
      }
    }
  }
}
