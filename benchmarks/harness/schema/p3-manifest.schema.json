{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi P3 Benchmark Manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "reference", "model", "thinking", "scoredRunCount", "runs", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "name": { "const": "pi-p3-benchmark" },
    "reference": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "model": { "const": "opencode-go/kimi-k2.7-code" },
    "thinking": { "const": "high" },
    "scoredRunCount": { "const": 33 },
    "runs": {
      "type": "array",
      "minItems": 33,
      "maxItems": 33,
      "items": { "$ref": "#/$defs/run" }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/run" },
          { "properties": { "scored": { "const": false }, "mode": { "enum": ["v8-cpu-prof", "v8-heap-prof"] } }, "required": ["mode"] }
        ]
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "required": ["id", "task", "scored"],
      "properties": {
        "id": { "type": "string", "pattern": "^p3-[a-z0-9-]+$" },
        "task": { "type": "string", "pattern": "^(0[1-9]|10)-[a-z0-9-]+$" },
        "scored": { "type": "boolean" },
        "pair": { "type": "string" },
        "variant": { "type": "string" },
        "interaction": { "enum": ["four-turn"] },
        "mode": { "type": "string" },
        "environment": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
