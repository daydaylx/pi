{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Benchmark Run Result",
  "description": "Ausgabeformat von harness/collect-metrics.mjs für einen einzelnen Benchmark-Lauf. Siehe benchmarks/SCORING.md für die Definition jeder Messgröße.",
  "type": "object",
  "required": [
    "schemaVersion",
    "task",
    "collectedAt",
    "automatic",
    "manualAssessment"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "description": "Aufgaben-ID, z. B. \"02-local-bug\""
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    },
    "automatic": {
      "type": "object",
      "description": "Vollautomatisch aus Session-Logs, run-history.jsonl und git diff erhoben. Nie manuell überschreiben.",
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "failedToolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "repeatedIdenticalFailures": {
          "type": "integer",
          "minimum": 0
        },
        "userCorrectionTurns": {
          "type": "integer",
          "minimum": 0
        },
        "durationMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "subagentCalls": {
          "type": "integer",
          "minimum": 0
        },
        "subagentModelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "subagentTokens": {
          "type": "object",
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "reasoning": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "subagentDurationMsTotal": {
          "type": "integer",
          "minimum": 0
        },
        "subagentFailures": {
          "type": "integer",
          "minimum": 0
        },
        "diff": {
          "type": ["object", "null"],
          "properties": {
            "changedFiles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changedFileCount": {
              "type": "integer",
              "minimum": 0
            },
            "linesAdded": {
              "type": "integer",
              "minimum": 0
            },
            "linesRemoved": {
              "type": "integer",
              "minimum": 0
            },
            "outOfScopeFiles": {
              "type": ["array", "null"],
              "items": {
                "type": "string"
              }
            },
            "snapshot": {
              "type": "object",
              "description": "Kanonische, inhaltsfreie Workspace-Sicht. Patches und Dateiinhalte werden nicht gespeichert.",
              "properties": {
                "schemaVersion": { "type": "string" },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "head": { "type": "string" },
                "staged": { "type": "array" },
                "unstaged": { "type": "array" },
                "untracked": { "type": "array", "items": { "type": "string" } },
                "renames": { "type": "array" },
                "deletions": { "type": "array" }
              }
            }
          }
        },
        "verify": {
          "type": ["object", "null"],
          "properties": {
            "exitCode": {
              "type": "integer"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            },
            "knownBaselineFailuresSeen": {
              "type": "integer",
              "minimum": 0,
              "description": "Siehe harness/BASELINE.md — Anzahl der 5 bekannten, referenzcommit-eigenen Testfehlschläge, die im Log gefunden wurden."
            },
            "likelyCausedByAgent": {
              "type": "boolean",
              "description": "false, wenn exitCode != 0 ausschließlich durch die bekannten Baseline-Fehlschläge erklärt wird."
            }
          }
        },
        "environment": {
          "type": "object",
          "description": "Optional reproducibility metadata supplied by a controller. It may contain only non-sensitive configuration fingerprints and explicit runtime facts; it must never contain credentials or a raw environment dump.",
          "properties": {
            "reference": {
              "type": "string"
            },
            "configHash": {
              "type": "string"
            },
            "configFiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                }
              }
            },
            "benchmarkOverlays": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                }
              }
            },
            "benchmarkEnvironmentOverrides": {
              "type": "object",
              "description": "Explizite, nicht-sensitive Benchmark-Umgebungswerte.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "harnessScaffolding": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                }
              }
            },
            "model": {
              "type": "string"
            },
            "thinking": {
              "type": "string"
            },
            "taskPromptFingerprint": {
              "type": "string"
            },
            "testOnly": {
              "type": "boolean"
            },
            "runtime": {
              "type": "object",
              "properties": {
                "nodeVersion": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "arch": {
                  "type": "string"
                },
                "piPackageVersion": {
                  "type": "string"
                },
                "piPackageFingerprint": {
                  "type": "string"
                },
                "piEntrypointFingerprint": {
                  "type": "string"
                }
              }
            },
            "runId": {
              "type": "string"
            },
            "task": {
              "type": "string"
            },
            "scored": {
              "type": "boolean"
            },
            "variant": {
              "type": ["string", "null"]
            },
            "pair": {
              "type": ["string", "null"]
            }
          }
        },
        "resources": {
          "type": "object",
          "description": "Optional GNU time -v measurements captured by a benchmark controller. Values are per launch plus non-sensitive aggregates.",
          "properties": {
            "launches": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "exitCode": {
                    "type": "integer"
                  },
                  "signal": {
                    "type": ["string", "null"]
                  },
                  "cpuUserSeconds": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "cpuSystemSeconds": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "wallSeconds": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "peakRssKiB": {
                    "type": ["number", "null"],
                    "minimum": 0
                  }
                }
              }
            },
            "totalCpuUserSeconds": {
              "type": "number",
              "minimum": 0
            },
            "totalCpuSystemSeconds": {
              "type": "number",
              "minimum": 0
            },
            "totalWallSeconds": {
              "type": "number",
              "minimum": 0
            },
            "peakRssKiB": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        }
      }
    },
    "manualAssessment": {
      "type": "object",
      "description": "Muss von einem Menschen ausgefüllt werden. Nie automatisch geraten oder mit einem Default befüllt (siehe Änderungsregeln in benchmarks/README.md).",
      "properties": {
        "solvedWithoutCorrection": {
          "type": ["boolean", "null"]
        },
        "unnecessaryLineChangesWithinScope": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "lostRequirements": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        },
        "repeatedFailuresWithoutContextChange": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "decisionPersistenceAfterCompaction": {
          "type": ["boolean", "null"],
          "description": "Messgröße 13 (inhaltlich): sind bestätigte Entscheidungen, Nicht-Ziele und Architekturentscheidungen im finalen Turn unverändert und widerspruchsfrei vorhanden?"
        },
        "projectStatusCorrectness": {
          "type": ["boolean", "null"],
          "description": "Messgröße 14: stimmt der berichtete Projektstatus (offene vs. erledigte Todos) mit Plan/Progress überein?"
        },
        "hallucinationCount": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Messgröße 15: Anzahl behaupteter Fakten im Abschluss-Turn, die nicht im PlanSnapshot belegt sind."
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
