{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi Benchmark P4 Run Result",
  "type": "object",
  "required": [
    "schemaVersion",
    "seriesId",
    "runId",
    "stackMode",
    "reference",
    "configFingerprint",
    "promptFingerprint",
    "resolvedRoles",
    "evaluator",
    "inputFingerprint",
    "sessionMetrics",
    "diff"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "seriesId": { "type": "string", "pattern": "^P4(?:-production)?$" },
    "configFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promptFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resolvedRoles": { "type": "object" },
    "evaluator": { "type": "object" },
    "inputFingerprint": { "type": "string" },
    "sessionMetrics": { "type": "object" },
    "diff": { "type": "object" }
  }
}
