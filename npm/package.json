{
  "name": "pi-extensions",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "scripts": {
    "test": "node ../tests/run-all.mjs",
    "test:coverage": "node ../tests/coverage.mjs",
    "test:coverage:baseline": "node ../tests/coverage.mjs --write-baseline",
    "test:runtime": "node ../tests/p1-runtime.mjs",
    "test:patches": "node ../tests/runtime-patches.mjs",
    "test:patches:pi-subagents": "node ../tests/pi-subagents-patch.mjs",
    "patch:runtime": "node ../scripts/apply-runtime-patches.mjs",
    "patch:pi-subagents": "node ../scripts/apply-pi-subagents-patch.mjs",
    "audit:check": "node ../scripts/check-npm-audit.mjs",
    "format": "prettier --write ..",
    "format:check": "prettier --check ..",
    "deadcode": "knip --directory ..",
    "typecheck": "tsc --noEmit -p ../tsconfig.json",
    "verify": "npm run format:check && npm run typecheck && npm run deadcode && npm run test:coverage && npm run test:patches && npm run test:patches:pi-subagents && npm run test:runtime && npm run audit:check"
  },
  "dependencies": {
    "@ujjwalgrover/pi-catppuccin": "1.0.0",
    "jiti": "2.7.0",
    "pi-subagents": "0.34.0",
    "pi-zentui": "0.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "24.12.4",
    "knip": "6.31.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
