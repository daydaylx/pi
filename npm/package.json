{
  "name": "pi-extensions",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "build": "npm exec tsc -- -p packages/frontend-protocol/tsconfig.json",
    "test:protocol-package": "npm run build && node --test packages/frontend-protocol/test/*.test.mjs",
    "test:frontend-server": "npm run build && node --test ../frontend-server/test/*.test.mjs",
    "test": "npm run test:protocol-package && npm run test:frontend-server && node ../tests/run-all.mjs",
    "test:coverage": "node ../tests/coverage.mjs",
    "test:coverage:baseline": "node ../tests/coverage.mjs --write-baseline",
    "test:runtime": "node ../tests/p1-runtime.mjs",
    "test:patches": "node ../tests/runtime-patches.mjs",
    "test:gui": "node ../gui/test/format-check.mjs && npm --prefix ../gui test",
    "patch:runtime": "node ../scripts/apply-runtime-patches.mjs",
    "audit:check": "node ../scripts/check-npm-audit.mjs",
    "format": "prettier --write ..",
    "format:check": "prettier --check ..",
    "deadcode": "knip --directory ..",
    "typecheck": "tsc --noEmit -p ../tsconfig.json",
    "check:imports": "node ../scripts/check-relative-imports.mjs",
    "check:versioned-tree": "node ../scripts/check-versioned-tree.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run deadcode && npm run test:coverage && npm run test:patches && npm run test:gui && npm run audit:check"
  },
  "dependencies": {
    "@ujjwalgrover/pi-catppuccin": "1.0.0",
    "jiti": "2.7.0",
    "pi-subagents": "https://codeload.github.com/daydaylx/pi-subagents/tar.gz/f59fc0d26bf055632363e9a4ca778ab1f09b5252",
    "pi-web-access": "0.24.2",
    "pi-zentui": "0.3.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "24.12.4",
    "knip": "6.31.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
