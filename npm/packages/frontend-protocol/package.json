{
  "name": "@daydaylx/pi-frontend-protocol",
  "version": "1.0.0",
  "description": "Versioned frontend contract for Pi CLI/TUI and external desktop frontends",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build && npm test"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
