# Sensible Daten
auth.json

# Session-Daten (groß + sensibel)
sessions/
docs/archive/session-logs/

# Plan-Ablage der Pi-Runtime (~/.pi/agent/plans/) -- fällt in diesem
# Dev-Checkout mit dem Repo-Root zusammen, ist aber Laufzeitzustand des
# Operators, nie Teil des Repos.
plans/

# Backups
backups/
*.bak-*
*.backup.*

# OpenRouter free-model cache (regenerated via /or-free-refresh)
openrouter-free-models.json

# Local clones of upstream packages (working area, not part of this repo)
/git/

# Subagent runtime artifacts
# pi-subagents/ = npm package working copy (installed by npm, runtime dep)
# /git/github.com/daydaylx/pi-subagents/ = upstream git clone for development
.pi-subagents/
pi-subagents/
run-history.jsonl

# Lokale Modell-/Extension-Laufzeitdaten
models-store.json
pi-crash.log
pi-debug.log

# Lokale Arbeitsauftrags-Pakete
pi-arbeitsauftraege-vereinfachung.zip

# Agent-Sitzungs-Scratch (Pläne, Debug-Skripte) — nie Teil des Repos
.agent/

# GUI-Build-Artefakte (Eigenbau-Minimal-Shell)
gui/node_modules/
gui/.npm-cache/
gui/.cache/
dist/

# Extern generierte Hooks (z. B. tty7 agent-hook bridge) — maschinenlokale
# Integration einer Drittanbieter-App, nie Teil des Repos
extensions/tty7/
