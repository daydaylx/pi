{
  "$schema": "./schemas/setup.schema.json",
  "ui": {
    "theme": "aurora-night",
    "motion": "contextual"
  },
  "permissions": {
    "unknownTools": "ask",
    "bash": "allow"
  },
  "lsp": {
    "enabled": true,
    "mode": "auto",
    "requestTimeoutMs": 10000,
    "idleShutdownMs": 600000
  },
  "verificationStatus": {
    "enabled": true
  },
  "verification": {
    "typecheck": {
      "command": "npm",
      "args": ["--prefix", "npm", "run", "typecheck"],
      "timeoutMs": 120000
    },
    "test": {
      "command": "npm",
      "args": ["--prefix", "npm", "run", "test"],
      "timeoutMs": 300000
    }
  }
}
