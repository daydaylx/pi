[Unit]
Description=Pi System shared-session host
After=default.target

[Service]
Type=simple
ExecStart=%h/.pi/agent/bin/pi-system-host
Restart=on-failure
RestartSec=2s
TimeoutStopSec=8s
RuntimeDirectory=pi-system-host
RuntimeDirectoryMode=0700
Environment=PI_CODING_AGENT_DIR=%h/.pi/agent
Environment=PI_SYSTEM_HOST_RUNTIME_DIR=%t
Environment=TMPDIR=%h/.pi/agent/profile-state/system/tmp
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=%h/.pi/agent %h/nixos-config
MemoryMax=1G
CPUQuota=200%
TasksMax=128

[Install]
WantedBy=default.target
